---
import {
  getProjectBySlug,
  getProjectHref,
  resumeData,
  type ProjectDetail,
} from "../data/resume";

const { profile, resume, projects } = resumeData;

const featuredProjects = projects.filter((project) => project.category === "featured");
const openSourceProjects = projects.filter((project) => project.category === "open_source");
const contactActions = profile.contacts.filter((contact) => contact.href !== "/resume");
const visibleResumeFactLabels = new Set(["技术能力", "相关背景", "擅长事项"]);
const resumeProfileFacts = resume.profileFacts.filter((fact) => visibleResumeFactLabels.has(fact.label));
const heroSummaryPoints = (() => {
  const concisePoints = resume.summaryPoints.filter((item) => !item.includes("："));
  return (concisePoints.length > 0 ? concisePoints : resume.summaryPoints).slice(0, 3);
})();
const resumeContentUpdatedAt = "2026-04-01";
const resumeComplianceNotice = "网页内容仅用于个人经历与项目展示，如发现不合法或不适宜公开的内容，请及时联系我删除。";
const resumeAutoGeneratedNotice = "展示网站为自动化生成网站，一切以简历 PDF 文件内容为准。";
// `resume` 页中的工作项目与开源项目统一使用同一套卡片渲染逻辑。
// `about` 页是面向开源社区的独立展示页，视觉语言和信息取舍应保持单独设计，不在这里做联动收敛。
const projectGroups = [
  { title: "工作项目", items: featuredProjects },
  { title: "开源项目", items: openSourceProjects },
].filter((group) => group.items.length > 0);
const honorExtrasWithImages = resume.honorExtras.filter((item) => item.images.length > 0);
const honorExtrasWithReferences = resume.honorExtras.filter((item) => item.references.length > 0);
const hasHonorExtras = honorExtrasWithImages.length > 0 || honorExtrasWithReferences.length > 0;

function countHonorReferencesByLabel(item: (typeof resume.honorExtras)[number], label: string) {
  return item.references.filter((reference) => reference.label === label).length;
}

function resolveHonorReferenceSummary(item: (typeof resume.honorExtras)[number]) {
  const patentCount = countHonorReferencesByLabel(item, "专利");
  if (patentCount > 0) {
    return `参与 ${patentCount} 项专利撰写。`;
  }

  return item.summary;
}

function isDefined<T>(value: T | undefined): value is T {
  return value !== undefined;
}

function looksLikePeriod(value: string) {
  return /(\d{4}[./]\d{1,2}\s*[-–]\s*(?:\d{4}[./]\d{1,2}|至今))/.test(value);
}

function resolveProjectCardPeriod(project: ProjectDetail) {
  const metaPeriod = project.meta.find(looksLikePeriod);
  if (metaPeriod) {
    return metaPeriod;
  }

  const archiveSection = project.sections.find((section) => section.type === "archive");
  if (!archiveSection) {
    return undefined;
  }

  for (const archive of archiveSection.sections) {
    for (const group of archive.groups ?? []) {
      if (group.title !== "项目时间") {
        continue;
      }

      const paragraph = group.paragraphs?.find(Boolean);
      if (paragraph) {
        return paragraph;
      }

      const item = group.items?.find(Boolean);
      if (item) {
        return item;
      }
    }
  }

  return undefined;
}

function resolveProjectCardMeta(project: ProjectDetail) {
  const period = resolveProjectCardPeriod(project);
  if (!period) {
    return project.meta;
  }

  return Array.from(new Set([...project.meta.filter((item) => !looksLikePeriod(item)), period]));
}

function resolveProjects(slugs?: string[]): ProjectDetail[] {
  return (slugs ?? []).map((slug) => getProjectBySlug(slug)).filter(isDefined);
}
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>简历 - 张国鑫</title>
  <meta name="description" content="张国鑫的网页简历，现游戏开发工程师，前知识图谱 / NLP 算法工程师，当前关注 AI 游戏应用、系统架构、性能优化与程序化生成。">
  <style>
    :root {
      --bg: #eef3f8;
      --surface: rgba(255, 255, 255, 0.9);
      --surface-strong: #ffffff;
      --text: #17202a;
      --text-secondary: #4d6175;
      --text-muted: #7d8b9b;
      --accent: #1f6feb;
      --accent-strong: #1558c0;
      --accent-soft: rgba(31, 111, 235, 0.08);
      --border: rgba(24, 39, 58, 0.12);
      --shadow: 0 18px 40px rgba(18, 38, 63, 0.08);
      --shadow-hover: 0 22px 48px rgba(18, 38, 63, 0.12);
      --hero-gradient: linear-gradient(135deg, rgba(31, 111, 235, 0.12), rgba(20, 184, 166, 0.08));
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", sans-serif;
      color: var(--text);
      background:
        radial-gradient(circle at top left, rgba(31, 111, 235, 0.08), transparent 28%),
        radial-gradient(circle at top right, rgba(20, 184, 166, 0.08), transparent 32%),
        var(--bg);
      line-height: 1.7;
      min-height: 100vh;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    .container {
      width: min(1120px, calc(100% - 32px));
      margin: 0 auto;
      padding: 28px 0 72px;
    }

    .nav {
      display: flex;
      align-items: center;
      gap: 14px;
      color: var(--text-muted);
      font-size: 14px;
      margin-bottom: 24px;
    }

    .nav a:hover {
      color: var(--accent);
    }

    .hero {
      background: var(--hero-gradient), var(--surface);
      border: 1px solid var(--border);
      border-radius: 28px;
      box-shadow: var(--shadow);
      padding: 40px;
      margin-bottom: 24px;
      position: relative;
      overflow: hidden;
    }

    .hero::after {
      content: "";
      position: absolute;
      inset: auto -60px -90px auto;
      width: 220px;
      height: 220px;
      border-radius: 50%;
      background: rgba(20, 184, 166, 0.08);
      filter: blur(8px);
    }

    .hero-eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 6px 12px;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.72);
      color: var(--accent-strong);
      font-size: 13px;
      font-weight: 700;
      margin-bottom: 18px;
    }

    .hero-notice {
      position: relative;
      z-index: 1;
      display: grid;
      gap: 6px;
      margin-bottom: 18px;
      padding: 12px 14px;
      border-radius: 18px;
      background: rgba(255, 255, 255, 0.76);
      border: 1px solid rgba(24, 39, 58, 0.08);
      color: var(--text-secondary);
      font-size: 13px;
      line-height: 1.6;
    }

    .hero-notice strong {
      color: var(--text);
      font-weight: 700;
    }

    .hero-grid {
      display: grid;
      grid-template-columns: minmax(0, 1.3fr) minmax(280px, 0.7fr);
      gap: 24px;
      position: relative;
      z-index: 1;
      align-items: start;
    }

    .hero-main {
      display: grid;
      gap: 20px;
    }

    .hero-intro {
      display: grid;
      grid-template-columns: 124px minmax(0, 1fr);
      gap: 22px;
      align-items: center;
    }

    .avatar-shell {
      position: relative;
      width: 124px;
      height: 124px;
      border-radius: 32px;
      padding: 6px;
      background: linear-gradient(135deg, rgba(31, 111, 235, 0.28), rgba(20, 184, 166, 0.18));
      box-shadow: 0 20px 36px rgba(16, 24, 40, 0.12);
    }

    .avatar-shell::after {
      content: "";
      position: absolute;
      inset: -10px;
      border-radius: 38px;
      border: 1px solid rgba(255, 255, 255, 0.42);
      pointer-events: none;
    }

    .avatar {
      width: 100%;
      height: 100%;
      object-fit: cover;
      border-radius: 26px;
      border: 3px solid rgba(255, 255, 255, 0.82);
      background: rgba(255, 255, 255, 0.72);
    }

    .hero-copy {
      display: grid;
      gap: 8px;
    }

    .hero h1 {
      font-size: clamp(34px, 4vw, 52px);
      line-height: 1.08;
      margin-bottom: 0;
    }

    .hero-role {
      color: var(--accent-strong);
      font-size: 15px;
      font-weight: 700;
      margin-bottom: 12px;
    }

    .hero-subtitle {
      max-width: 740px;
      color: var(--text-secondary);
      font-size: 17px;
      margin-bottom: 0;
    }

    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      margin-bottom: 20px;
    }

    .button {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 11px 18px;
      border-radius: 999px;
      border: 1px solid var(--border);
      background: var(--surface-strong);
      color: var(--text);
      font-size: 14px;
      transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s, color 0.2s;
      box-shadow: 0 8px 18px rgba(16, 24, 40, 0.06);
    }

    .button:hover {
      transform: translateY(-2px);
      border-color: rgba(31, 111, 235, 0.24);
      color: var(--accent);
      box-shadow: 0 12px 22px rgba(16, 24, 40, 0.08);
    }

    .button.primary {
      background: var(--accent);
      border-color: transparent;
      color: white;
    }

    .button.primary:hover {
      color: white;
      background: var(--accent-strong);
    }

    .summary-list {
      display: grid;
      gap: 10px;
      color: var(--text-secondary);
      font-size: 15px;
    }

    .summary-item {
      display: grid;
      grid-template-columns: 14px minmax(0, 1fr);
      gap: 10px;
      align-items: start;
    }

    .summary-item span:first-child {
      color: var(--accent);
      font-weight: 700;
    }

    .info-card {
      background: rgba(255, 255, 255, 0.72);
      border: 1px solid rgba(255, 255, 255, 0.65);
      border-radius: 22px;
      padding: 22px;
      backdrop-filter: blur(8px);
      min-width: 0;
      overflow: hidden;
    }

    .info-card h2 {
      font-size: 15px;
      margin-bottom: 14px;
    }

    .info-stack {
      display: grid;
      gap: 10px;
      min-width: 0;
    }

    .info-item {
      padding: 10px 0;
      border-top: 1px solid rgba(24, 39, 58, 0.08);
      min-width: 0;
    }

    .info-item:first-child {
      padding-top: 0;
      border-top: 0;
    }

    .info-label {
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--text-muted);
      margin-bottom: 4px;
    }

    .info-value {
      color: var(--text);
      font-size: 15px;
      line-height: 1.75;
      overflow-wrap: anywhere;
      word-break: break-word;
    }

    .project-grid,
    .edu-grid {
      display: grid;
      gap: 16px;
      margin-bottom: 24px;
    }

    .project-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .edu-grid {
      grid-template-columns: 1.1fr 0.9fr;
    }

    .project-card,
    .panel {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 22px;
      box-shadow: var(--shadow);
      padding: 24px;
    }

    .project-desc,
    .text-note,
    .simple-list,
    .experience-summary,
    .experience-role,
    .bullet-item {
      color: var(--text-secondary);
    }


    .section {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 26px;
      box-shadow: var(--shadow);
      margin-bottom: 24px;
      padding: 30px;
    }

    .section-header {
      display: flex;
      gap: 16px;
      align-items: center;
      margin-bottom: 20px;
    }

    .section-header h2 {
      font-size: 28px;
    }

    .timeline {
      position: relative;
      display: grid;
      gap: 18px;
    }

    .timeline::before {
      content: "";
      position: absolute;
      top: 4px;
      bottom: 4px;
      left: 11px;
      width: 2px;
      background: linear-gradient(to bottom, rgba(31, 111, 235, 0.3), rgba(20, 184, 166, 0.2));
    }

    .experience-card {
      position: relative;
      margin-left: 34px;
      background: var(--surface-strong);
      border: 1px solid var(--border);
      border-radius: 22px;
      padding: 22px;
      transition: transform 0.2s, box-shadow 0.2s;
    }

    .experience-card:hover {
      transform: translateY(-3px);
      box-shadow: var(--shadow-hover);
    }

    .experience-card::before {
      content: "";
      position: absolute;
      width: 12px;
      height: 12px;
      border-radius: 50%;
      background: var(--accent);
      border: 4px solid #dfe8fb;
      left: -30px;
      top: 24px;
    }

    .experience-top {
      display: flex;
      justify-content: space-between;
      gap: 16px;
      margin-bottom: 8px;
      align-items: flex-start;
    }

    .experience-title {
      font-size: 20px;
      margin-bottom: 4px;
    }

    .experience-period {
      flex: 0 0 auto;
      padding: 6px 12px;
      background: var(--accent-soft);
      color: var(--accent-strong);
      border-radius: 999px;
      font-size: 12px;
      font-weight: 700;
    }

    .bullet-list,
    .simple-list {
      display: grid;
      gap: 10px;
    }

    .bullet-list {
      margin-top: 14px;
    }

    .honor-extra-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
      margin-top: 8px;
    }

    .honor-extra-stack {
      display: grid;
      gap: 16px;
    }

    .honor-extra-card {
      display: grid;
      gap: 12px;
      padding: 16px;
      border-radius: 18px;
      border: 1px solid rgba(24, 39, 58, 0.08);
      background: rgba(255, 255, 255, 0.76);
    }

    .honor-extra-title {
      font-size: 16px;
      font-weight: 700;
      color: var(--text);
    }

    .honor-extra-summary {
      font-size: 14px;
      color: var(--text-secondary);
    }

    .honor-image-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
      gap: 12px;
    }

    .honor-image-card {
      display: grid;
      gap: 8px;
      color: inherit;
    }

    .honor-image-card img {
      width: 100%;
      height: 160px;
      object-fit: contain;
      border-radius: 14px;
      border: 1px solid rgba(24, 39, 58, 0.08);
      background: #eef3f8;
      padding: 8px;
    }

    .honor-image-card strong {
      font-size: 13px;
      line-height: 1.4;
    }

    .honor-reference-list {
      display: grid;
      gap: 10px;
    }

    .honor-reference-item {
      display: grid;
      gap: 4px;
      padding-bottom: 10px;
      border-bottom: 1px solid rgba(24, 39, 58, 0.08);
    }

    .honor-reference-item:last-child {
      padding-bottom: 0;
      border-bottom: 0;
    }

    .honor-reference-label {
      font-size: 12px;
      font-weight: 700;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }

    .honor-reference-value {
      font-size: 14px;
      color: var(--text-secondary);
      line-height: 1.6;
    }

    .honor-reference-details {
      border-radius: 16px;
      border: 1px solid rgba(31, 111, 235, 0.12);
      background: #f8fbff;
      padding: 12px 14px;
    }

    .honor-reference-details summary {
      cursor: pointer;
      color: var(--accent-strong);
      font-size: 14px;
      font-weight: 700;
      list-style: none;
    }

    .honor-reference-details summary::-webkit-details-marker {
      display: none;
    }

    .honor-reference-details .honor-reference-list {
      margin-top: 12px;
    }

    .bullet-item {
      display: grid;
      grid-template-columns: 10px minmax(0, 1fr);
      gap: 10px;
      align-items: start;
      font-size: 14px;
    }

    .bullet-item span:first-child {
      color: var(--accent);
      font-weight: 700;
    }

    .experience-details {
      margin-top: 14px;
      padding: 14px 16px;
      border-radius: 18px;
      border: 1px solid rgba(31, 111, 235, 0.12);
      background: #f8fbff;
    }

    .experience-details summary {
      cursor: pointer;
      color: var(--accent-strong);
      font-size: 14px;
      font-weight: 700;
      list-style: none;
    }

    .experience-details summary::-webkit-details-marker {
      display: none;
    }

    .experience-detail-list {
      display: grid;
      gap: 14px;
      margin-top: 12px;
    }

    .experience-detail-group {
      display: grid;
      gap: 8px;
    }

    .experience-detail-group-title {
      color: var(--text);
      font-size: 14px;
      font-weight: 700;
    }

    .experience-detail-items {
      display: grid;
      gap: 8px;
    }

    .experience-detail-text {
      font-size: 14px;
    }

    .link-row,
    .meta-row,
    .tag-row {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }

    .meta-row {
      margin-bottom: 12px;
    }

    .link-row {
      margin-top: 14px;
    }

    .link-pill,
    .meta-pill,
    .tag {
      border-radius: 999px;
      font-size: 12px;
      padding: 5px 10px;
    }

    .link-pill,
    .meta-pill {
      color: var(--accent-strong);
      background: #f5f9ff;
      border: 1px solid rgba(31, 111, 235, 0.12);
    }

    .link-pill {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 9px 14px;
      font-weight: 700;
    }

    .project-card {
      transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s;
    }

    .project-card:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow-hover);
      border-color: rgba(31, 111, 235, 0.22);
    }

    .project-card h3,
    .panel h3 {
      font-size: 18px;
      margin-bottom: 10px;
    }

    .project-subtitle {
      color: var(--text);
      font-size: 14px;
      font-weight: 400;
      line-height: 1.75;
      margin-bottom: 10px;
    }

    .project-desc {
      font-size: 15px;
      margin-bottom: 14px;
    }

    .tag {
      color: var(--text-secondary);
      background: #f2f6fb;
      border: 1px solid rgba(24, 39, 58, 0.08);
    }

    .footer {
      text-align: center;
      color: var(--text-muted);
      font-size: 14px;
      padding-top: 10px;
    }

    @media (max-width: 900px) {
      .hero-grid,
      .project-grid,
      .edu-grid,
      .honor-extra-grid {
        grid-template-columns: 1fr;
      }

      .hero-intro {
        grid-template-columns: 1fr;
        justify-items: start;
      }
    }

    @media (max-width: 720px) {
      .container {
        width: min(100% - 24px, 1120px);
        padding: 20px 0 56px;
      }

      .hero,
      .section,
      .project-card,
      .panel {
        padding: 22px;
        border-radius: 22px;
      }

      .section-header,
      .experience-top {
        display: grid;
      }

      .hero-intro {
        gap: 18px;
      }

      .avatar-shell {
        width: 110px;
        height: 110px;
        border-radius: 28px;
      }

      .avatar-shell::after {
        border-radius: 34px;
      }

      .avatar {
        border-radius: 22px;
      }

      .section-header h2 {
        font-size: 24px;
      }

      .experience-card {
        margin-left: 26px;
      }

      .experience-card::before {
        left: -22px;
      }

      .timeline::before {
        left: 9px;
      }
    }
  </style>
</head>
<body>
  <div class="container" data-pagefind-body>
    <nav class="nav">
      <a href="/">首页</a>
      <span>/</span>
      <a href="/about">关于</a>
      <span>/</span>
      <span>简历</span>
    </nav>

    <section class="hero">
      <div class="hero-notice">
        <div><strong>内容更新时间：</strong>{resumeContentUpdatedAt}</div>
        <div>{resumeComplianceNotice}</div>
        <div>{resumeAutoGeneratedNotice}</div>
      </div>
      <div class="hero-eyebrow">Resume / Experience</div>
      <div class="hero-grid">
        <div class="hero-main">
          <div class="hero-intro">
            <div class="avatar-shell">
              <img src="/avatar.png" alt={profile.name} class="avatar">
            </div>
            <div class="hero-copy">
              <h1>{profile.name}</h1>
              <div class="hero-role">{profile.role}</div>
              <p class="hero-subtitle">{resume.headline}</p>
            </div>
          </div>
          <div class="hero-actions">
            <a class="button primary" href="/about">查看 About</a>
            {contactActions.map((contact) => (
              <a
                class="button"
                href={contact.href}
                target={contact.external ? "_blank" : undefined}
                rel={contact.external ? "noopener" : undefined}
                data-copy-email={contact.href.startsWith("mailto:") ? "true" : undefined}
                data-email={contact.href.startsWith("mailto:") ? contact.href.replace("mailto:", "") : undefined}
              >{contact.label}</a>
            ))}
          </div>
          <div class="summary-list">
            {heroSummaryPoints.map((item) => (
              <div class="summary-item"><span>•</span><div>{item}</div></div>
            ))}
          </div>
        </div>

        <aside class="info-card">
          {/* 个人画像：对外展示方向、补充背景、擅长与联系方式。 */}
          <div class="info-stack">
            {resumeProfileFacts.map((fact) => (
              <div class="info-item">
                <div class="info-label">{fact.label}</div>
                <div class="info-value">{fact.value}</div>
              </div>
            ))}
          </div>
        </aside>
      </div>
    </section>

    <section class="section">
      <div class="section-header">
        <div><h2>工作经历</h2></div>
        {/* 工作经历区只展示标题与内容，导览性说明不直接输出到页面。 */}
      </div>
      <div class="timeline">
        {resume.experiences.map((experience) => {
          const relatedProjects = resolveProjects(experience.projectSlugs);

          return (
            <article class="experience-card">
              <div class="experience-top">
                <div>
                  <h3 class="experience-title">{experience.company}</h3>
                  <div class="experience-role">{experience.role}</div>
                </div>
                <div class="experience-period">{experience.period}</div>
              </div>
              <p class="experience-summary">{experience.summary}</p>
              <div class="bullet-list">
                {experience.bullets.map((bullet) => (
                  <div class="bullet-item"><span>•</span><div>{bullet}</div></div>
                ))}
              </div>
              {relatedProjects.length > 0 && (
                <div class="link-row">
                  {relatedProjects.map((project) => (
                    <a class="link-pill" href={getProjectHref(project.slug)}>{project.title}详情</a>
                  ))}
                </div>
              )}
              {experience.details && ((experience.details.refined && experience.details.refined.length > 0) || (experience.details.original && experience.details.original.length > 0)) && (
                <details class="experience-details">
                  <summary>查看完整说明</summary>
                  <div class="experience-detail-list">
                    {experience.details.refined && experience.details.refined.length > 0 && (
                      <div class="experience-detail-group">
                        <div class="experience-detail-group-title">{experience.details.refinedTitle ?? "详细补充"}</div>
                        <div class="experience-detail-items">
                          {experience.details.refined.map((detail) => (
                            <p class="experience-detail-text">{detail}</p>
                          ))}
                        </div>
                      </div>
                    )}
                    {experience.details.original && experience.details.original.length > 0 && (
                      <div class="experience-detail-group">
                        <div class="experience-detail-group-title">{experience.details.originalTitle ?? "简历原文"}</div>
                        <div class="experience-detail-items">
                          {experience.details.original.map((detail) => (
                            <p class="experience-detail-text">{detail}</p>
                          ))}
                        </div>
                      </div>
                    )}
                  </div>
                </details>
              )}
              {experience.note && <p class="text-note" style="margin-top: 10px;">{experience.note}</p>}
            </article>
          );
        })}
      </div>
    </section>

    {projectGroups.map((group) => (
      <section class="section">
        <div class="section-header">
          <div><h2>{group.title}</h2></div>
          {/* 这里只统一 resume 内部两个项目分组的卡片结构，不影响 about 页的独立设计。 */}
        </div>
        <div class="project-grid">
          {group.items.map((project) => (
            <a class="project-card" href={getProjectHref(project.slug)}>
              <h3>{project.title}</h3>
              <div class="project-subtitle">{project.subtitle}</div>
              <div class="meta-row">
                {resolveProjectCardMeta(project).map((item) => (
                  <span class="meta-pill">{item}</span>
                ))}
              </div>
              <p class="project-desc">{project.description}</p>
              <div class="tag-row">
                {project.tags.map((tag) => (
                  <span class="tag">{tag}</span>
                ))}
              </div>
            </a>
          ))}
        </div>
      </section>
    ))}

    <section class="section">
      <div class="section-header">
        <div><h2>荣誉与教育</h2></div>
      </div>
      <div class="edu-grid">
        <div class="panel">
          <h3>荣誉与奖项</h3>
          <div class="simple-list">
            {resume.honors.map((honor) => (
              <div>{honor}</div>
            ))}
          </div>
        </div>
        <div class="panel">
          <h3>教育经历</h3>
          <div class="simple-list">
            <div><strong>{resume.education.school}</strong></div>
            <div>{resume.education.degree}</div>
            <div>{resume.education.period}</div>
            {resume.education.details.map((detail) => (
              <div>{detail}</div>
            ))}
          </div>
        </div>
      </div>

      {hasHonorExtras && (
        <div class="honor-extra-grid">
          {honorExtrasWithImages.length > 0 && (
            <div class="panel">
              <h3>荣誉相关图片</h3>
              <div class="honor-extra-stack">
                {honorExtrasWithImages.map((item) => (
                  <div class="honor-extra-card">
                    <div class="honor-image-grid">
                      {item.images.map((image) => (
                        <a class="honor-image-card" href={image.src} target="_blank" rel="noopener">
                          <img src={image.src} alt={image.alt ?? image.title}>
                          <strong>{image.title}</strong>
                        </a>
                      ))}
                    </div>
                  </div>
                ))}
              </div>
            </div>
          )}

          {honorExtrasWithReferences.length > 0 && (
            <div class="panel">
              <h3>荣誉相关资料</h3>
              <div class="honor-extra-stack">
                {honorExtrasWithReferences.map((item) => {
                  const referenceSummary = resolveHonorReferenceSummary(item);

                  return (
                    <div class="honor-extra-card">
                      <div class="honor-extra-title">{item.title}</div>
                      {referenceSummary && <div class="honor-extra-summary">{referenceSummary}</div>}
                      <details class="honor-reference-details">
                        <summary>查看专利列表</summary>
                        <div class="honor-reference-list">
                          {item.references.map((reference) => (
                            <div class="honor-reference-item">
                              <div class="honor-reference-label">{reference.label}</div>
                              {reference.href ? (
                                <a class="honor-reference-value" href={reference.href} target={reference.external ? '_blank' : undefined} rel={reference.external ? 'noopener' : undefined}>{reference.value}</a>
                              ) : (
                                <div class="honor-reference-value">{reference.value}</div>
                              )}
                            </div>
                          ))}
                        </div>
                      </details>
                    </div>
                  );
                })}
              </div>
            </div>
          )}
        </div>
      )}
    </section>

    <div class="footer">
      <p>简历网页生成能力由统一的 Resume Schema 与导入链路驱动。</p>
    </div>
  </div>
  <script is:inline>
    document.querySelectorAll('[data-copy-email="true"]').forEach((link) => {
      const originalLabel = link.textContent?.trim() ?? "Email";
      let resetTimer;

      link.addEventListener("click", async (event) => {
        event.preventDefault();

        const email = link.getAttribute("data-email");
        if (!email) {
          return;
        }

        try {
          await navigator.clipboard.writeText(email);
          link.textContent = "已复制邮箱";
          clearTimeout(resetTimer);
          resetTimer = window.setTimeout(() => {
            link.textContent = originalLabel;
          }, 1600);
        } catch {
          window.location.href = `mailto:${email}`;
        }
      });
    });
  </script>
</body>
</html>




