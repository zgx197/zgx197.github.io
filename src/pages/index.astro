---
const posts = await Astro.glob('../content/blog/*.md');
const sortedPosts = posts
  .sort((a, b) => new Date(b.frontmatter.date || 0) - new Date(a.frontmatter.date || 0))
  .map((post) => ({
    ...post,
    url: `/blog/${post.file.split('/').pop().replace('.md', '')}/`,
  }));

const latestPosts = sortedPosts.slice(0, 6);
const allTags = Array.from(
  new Set(
    sortedPosts.flatMap((post) => post.frontmatter.tags ?? []),
  ),
).slice(0, 12);
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>张国鑫的博客</title>
  <meta name="description" content="张国鑫的个人博客，记录开发、工具、架构与技术思考。">
  <link href="/pagefind/pagefind-ui.css" rel="stylesheet">
  <style>
    :root {
      --bg: #eef3f8;
      --surface: rgba(255, 255, 255, 0.92);
      --surface-strong: #ffffff;
      --text: #17202a;
      --text-secondary: #4d6175;
      --text-muted: #7d8b9b;
      --accent: #1f6feb;
      --accent-strong: #1558c0;
      --border: rgba(24, 39, 58, 0.12);
      --shadow: 0 18px 40px rgba(18, 38, 63, 0.08);
      --shadow-hover: 0 22px 48px rgba(18, 38, 63, 0.12);
      --hero-gradient: linear-gradient(135deg, rgba(31, 111, 235, 0.12), rgba(20, 184, 166, 0.08));
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", sans-serif;
      color: var(--text);
      background:
        radial-gradient(circle at top left, rgba(31, 111, 235, 0.08), transparent 28%),
        radial-gradient(circle at top right, rgba(20, 184, 166, 0.08), transparent 32%),
        var(--bg);
      line-height: 1.7;
      min-height: 100vh;
    }

    a { color: inherit; text-decoration: none; }

    .container {
      width: min(1040px, calc(100% - 32px));
      margin: 0 auto;
      padding: 28px 0 72px;
    }

    .topbar {
      display: flex;
      justify-content: space-between;
      gap: 16px;
      align-items: center;
      margin-bottom: 24px;
      color: var(--text-muted);
      font-size: 14px;
    }

    .nav {
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
      align-items: center;
    }

    .nav a:hover {
      color: var(--accent);
    }

    .hero,
    .section,
    .post-card {
      background: var(--surface);
      border: 1px solid var(--border);
      box-shadow: var(--shadow);
    }

    .hero {
      background: var(--hero-gradient), var(--surface);
      border-radius: 28px;
      padding: 40px;
      margin-bottom: 24px;
      position: relative;
      overflow: hidden;
    }

    .hero::after {
      content: "";
      position: absolute;
      inset: auto -60px -90px auto;
      width: 220px;
      height: 220px;
      border-radius: 50%;
      background: rgba(20, 184, 166, 0.08);
      filter: blur(8px);
    }

    .hero-inner {
      position: relative;
      z-index: 1;
      max-width: 760px;
    }

    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 6px 12px;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.72);
      color: var(--accent-strong);
      font-size: 13px;
      font-weight: 600;
      margin-bottom: 18px;
    }

    .hero h1 {
      font-size: clamp(34px, 4vw, 54px);
      line-height: 1.05;
      margin-bottom: 12px;
    }

    .hero-copy {
      color: var(--text-secondary);
      font-size: 17px;
      max-width: 720px;
      margin-bottom: 18px;
    }

    .tag-row {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
    }

    .tag {
      color: var(--text-secondary);
      background: #f2f6fb;
      border: 1px solid rgba(24, 39, 58, 0.08);
      border-radius: 999px;
      font-size: 12px;
      padding: 5px 10px;
    }

    .section {
      border-radius: 26px;
      padding: 30px;
      margin-bottom: 24px;
    }

    .section-head {
      display: flex;
      justify-content: space-between;
      gap: 16px;
      align-items: flex-end;
      margin-bottom: 20px;
    }

    .section-head h2 {
      font-size: 28px;
    }

    .section-head p {
      color: var(--text-muted);
      font-size: 14px;
      max-width: 480px;
    }

    .search-shell {
      background: var(--surface-strong);
      border: 1px solid var(--border);
      border-radius: 18px;
      padding: 14px;
      margin-bottom: 20px;
    }

    #search {
      --pagefind-ui-scale: 0.9;
      --pagefind-ui-primary: var(--accent);
      --pagefind-ui-text: var(--text);
      --pagefind-ui-background: transparent;
      --pagefind-ui-border: transparent;
    }

    .post-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
    }

    .post-card {
      border-radius: 22px;
      padding: 22px;
      transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s;
    }

    .post-card:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow-hover);
      border-color: rgba(31, 111, 235, 0.22);
    }

    .post-card h3 {
      font-size: 18px;
      margin-bottom: 8px;
    }

    .post-meta,
    .post-copy,
    .empty-state {
      color: var(--text-secondary);
      font-size: 15px;
    }

    .post-copy {
      margin: 10px 0 16px;
    }

    .footer {
      text-align: center;
      color: var(--text-muted);
      font-size: 14px;
      padding-top: 4px;
    }

    @media (max-width: 920px) {
      .post-grid {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 720px) {
      .container {
        width: min(100% - 24px, 1040px);
        padding: 20px 0 56px;
      }

      .hero,
      .section,
      .post-card {
        padding: 22px;
        border-radius: 22px;
      }

      .topbar,
      .section-head {
        display: grid;
      }

      .section-head h2 {
        font-size: 24px;
      }
    }
  </style>
</head>
<body>
  <div class="container" data-pagefind-body>
    <div class="topbar">
      <div>Blog</div>
      <nav class="nav">
        <a href="https://github.com/zgx197" target="_blank" rel="noopener">GitHub</a>
      </nav>
    </div>

    <section class="hero">
      <div class="hero-inner">
        <div class="eyebrow">Blog / Notes</div>
        <h1>张国鑫的博客</h1>
        <p class="hero-copy">这里主要记录开发过程、工具实践、架构思考和一些持续积累中的技术笔记。首页只保留博客内容与文章检索。</p>
        {allTags.length > 0 && (
          <div class="tag-row">
            {allTags.map((tag) => (
              <span class="tag">{tag}</span>
            ))}
          </div>
        )}
      </div>
    </section>

    <section class="section">
      <div class="section-head">
        <div><h2>文章搜索</h2></div>
        <p>可以直接搜索文章标题、正文关键词和标签。</p>
      </div>
      <div class="search-shell">
        <div id="search"></div>
      </div>
    </section>

    <section class="section">
      <div class="section-head">
        <div><h2>最新文章</h2></div>
        <p>按时间排序展示最近更新的内容。</p>
      </div>
      {latestPosts.length > 0 ? (
        <div class="post-grid">
          {latestPosts.map((post) => (
            <a class="post-card" href={post.url}>
              <h3>{post.frontmatter.title}</h3>
              <p class="post-meta">{new Date(post.frontmatter.date).toLocaleDateString('zh-CN')}</p>
              {post.frontmatter.description && <p class="post-copy">{post.frontmatter.description}</p>}
              <div class="tag-row">
                {(post.frontmatter.tags ?? []).slice(0, 4).map((tag) => (
                  <span class="tag">{tag}</span>
                ))}
              </div>
            </a>
          ))}
        </div>
      ) : (
        <p class="empty-state">当前还没有文章内容。</p>
      )}
    </section>

    <div class="footer">
      <p>这里是博客首页。</p>
    </div>
  </div>

  <script is:inline src="/pagefind/pagefind-ui.js"></script>
  <script>
    window.addEventListener('DOMContentLoaded', () => {
      new PagefindUI({
        element: '#search',
        placeholder: '搜索文章...',
        showImages: false,
        showSubResults: false,
        translations: {
          placeholder: '搜索文章...',
          zero_results: '无结果',
          many_results: '# 个结果',
          one_result: '1 个结果',
        },
      });
    });
  </script>
</body>
</html>
