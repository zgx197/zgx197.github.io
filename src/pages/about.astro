          </svg>
          GitHub
        </a>
        <a href="https://steamcommunity.com/profiles/76561198340584094" target="_blank" rel="noopener">
          <svg viewBox="0 0 16 16" fill="currentColor">
            <path d="M8 0a8 8 0 0 0-8 8 8 8 0 0 0 8 8 8 8 0 0 0 8-8 8 8 0 0 0-8-8zm0 1.5a6.5 6.5 0 0 1 6.5 6.5 6.5 6.5 0 0 1-6.5 6.5A6.5 6.5 0 0 1 1.5 8 6.5 6.5 0 0 1 8 1.5z"/>
            <path d="M4.5 7a.5.5 0 0 0-.5.5v3a.5.5 0 0 0 .5.5h3a.5.5 0 0 0 .5-.5v-3a.5.5 0 0 0-.5-.5h-3z"/>
