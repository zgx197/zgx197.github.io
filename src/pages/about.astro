---
import { getProjectHref, openSourceProjectCards, resumeData } from '../data/resume';

const { profile } = resumeData;
// About 页面用于对开源社区展示个人与开源项目，不作为简历页入口。
const aboutContacts = profile.contacts.filter((contact) => contact.href !== '/resume');
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>关于 - 张国鑫</title>
  <meta name="description" content="张国鑫的个人介绍页，现游戏开发工程师，前知识图谱 / NLP 算法工程师，当前关注 AI 游戏应用、系统架构、性能优化与程序化生成。">
  <style>
    :root {
      --bg: #eef3f8;
      --surface: rgba(255, 255, 255, 0.9);
      --surface-strong: #ffffff;
      --text: #17202a;
      --text-secondary: #4d6175;
      --text-muted: #7d8b9b;
      --accent: #1f6feb;
      --accent-strong: #1558c0;
      --border: rgba(24, 39, 58, 0.12);
      --shadow: 0 18px 40px rgba(18, 38, 63, 0.08);
      --shadow-hover: 0 22px 48px rgba(18, 38, 63, 0.12);
      --hero-gradient: linear-gradient(135deg, rgba(31, 111, 235, 0.12), rgba(20, 184, 166, 0.08));
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", sans-serif;
      color: var(--text);
      background:
        radial-gradient(circle at top left, rgba(31, 111, 235, 0.08), transparent 28%),
        radial-gradient(circle at top right, rgba(20, 184, 166, 0.08), transparent 32%),
        var(--bg);
      line-height: 1.7;
      min-height: 100vh;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    .container {
      width: min(1120px, calc(100% - 32px));
      margin: 0 auto;
      padding: 28px 0 72px;
    }

    .nav {
      display: flex;
      align-items: center;
      gap: 14px;
      color: var(--text-muted);
      font-size: 14px;
      margin-bottom: 24px;
    }

    .nav a:hover {
      color: var(--accent);
    }

    .hero {
      background: var(--hero-gradient), var(--surface);
      border: 1px solid var(--border);
      border-radius: 28px;
      box-shadow: var(--shadow);
      padding: 40px;
      margin-bottom: 24px;
      position: relative;
      overflow: hidden;
    }

    .hero::after {
      content: "";
      position: absolute;
      inset: auto -60px -90px auto;
      width: 220px;
      height: 220px;
      border-radius: 50%;
      background: rgba(20, 184, 166, 0.08);
      filter: blur(8px);
    }

    .hero-eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 6px 12px;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.72);
      color: var(--accent-strong);
      font-size: 13px;
      font-weight: 600;
      margin: 0 auto 18px;
    }

    .hero-stack {
      position: relative;
      z-index: 1;
      display: grid;
      gap: 16px;
      max-width: 620px;
      margin: 0 auto;
      justify-items: center;
    }

    .profile {
      display: grid;
      gap: 16px;
      justify-items: center;
      text-align: center;
    }

    .avatar-shell {
      position: relative;
      width: fit-content;
    }

    .avatar-shell::before {
      content: "";
      position: absolute;
      inset: -6px;
      border-radius: 999px;
      background: linear-gradient(135deg, rgba(31, 111, 235, 0.32), rgba(20, 184, 166, 0.2));
      z-index: -1;
    }

    .avatar {
      width: 136px;
      height: 136px;
      object-fit: cover;
      border-radius: 50%;
      border: 4px solid rgba(255, 255, 255, 0.78);
      box-shadow: 0 18px 36px rgba(16, 24, 40, 0.12);
    }

    .profile-copy {
      display: grid;
      gap: 8px;
      justify-items: center;
    }

    .hero-title {
      font-size: clamp(30px, 3.4vw, 46px);
      line-height: 1.08;
      margin-bottom: 0;
    }

    .hero-role {
      font-size: 15px;
      color: var(--accent-strong);
      font-weight: 600;
      margin-bottom: 0;
    }

    .hero-bio {
      color: var(--text-secondary);
      font-size: 15px;
      max-width: 520px;
    }

    .hero-card {
      width: fit-content;
      max-width: 100%;
    }

    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: 2px;
      justify-content: center;
    }

    .button {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 10px 16px;
      border-radius: 999px;
      border: 1px solid var(--border);
      background: var(--surface-strong);
      color: var(--text);
      font-size: 14px;
      transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s, color 0.2s;
      box-shadow: 0 8px 18px rgba(16, 24, 40, 0.06);
    }

    .button:hover {
      transform: translateY(-2px);
      border-color: rgba(31, 111, 235, 0.24);
      color: var(--accent);
      box-shadow: 0 12px 22px rgba(16, 24, 40, 0.08);
    }

    .button.primary {
      background: var(--accent);
      border-color: transparent;
      color: white;
    }

    .button.primary:hover {
      color: white;
      background: var(--accent-strong);
    }

    .section {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 26px;
      box-shadow: var(--shadow);
      padding: 34px;
      margin-bottom: 24px;
    }

    .section-header {
      display: flex;
      justify-content: space-between;
      gap: 16px;
      align-items: flex-end;
      margin-bottom: 22px;
    }

    .section-header h2 {
      font-size: 28px;
    }

    .section-header p {
      color: var(--text-muted);
      font-size: 14px;
      max-width: 460px;
    }

    .project-list {
      display: grid;
      gap: 18px;
    }

    .project-card {
      display: block;
      background: var(--surface-strong);
      border: 1px solid var(--border);
      border-radius: 22px;
      padding: 24px;
      transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s;
    }

    .project-card:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow-hover);
      border-color: rgba(31, 111, 235, 0.22);
    }

    .project-top {
      display: flex;
      justify-content: space-between;
      gap: 16px;
      align-items: flex-start;
      margin-bottom: 12px;
    }

    .project-name {
      font-size: 20px;
      font-weight: 700;
    }

    .project-arrow {
      color: var(--text-muted);
      font-size: 20px;
      transition: transform 0.2s, color 0.2s;
    }

    .project-card:hover .project-arrow {
      transform: translateX(4px);
      color: var(--accent);
    }

    .meta-row,
    .tag-row {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }

    .meta-row {
      margin-bottom: 14px;
    }

    .meta-pill,
    .tag {
      font-size: 12px;
      border-radius: 999px;
      padding: 5px 10px;
    }

    .meta-pill {
      color: var(--accent-strong);
      background: #f5f9ff;
      border: 1px solid rgba(31, 111, 235, 0.12);
    }

    .tag {
      color: var(--text-secondary);
      background: #f2f6fb;
      border: 1px solid rgba(24, 39, 58, 0.08);
    }

    .project-desc {
      color: var(--text-secondary);
      font-size: 15px;
      margin-bottom: 16px;
    }

    @media (max-width: 720px) {
      .container {
        width: min(100% - 24px, 1120px);
        padding: 20px 0 56px;
      }

      .hero,
      .section {
        padding: 24px;
        border-radius: 22px;
      }

      .avatar {
        width: 110px;
        height: 110px;
      }

      .project-top,
      .section-header {
        display: grid;
      }

      .section-header h2 {
        font-size: 24px;
      }
    }
  </style>
</head>
<body>
  <div class="container" data-pagefind-body>
    <nav class="nav">
      <a href="/">首页</a>
      <span>/</span>
      <span>关于</span>
    </nav>

    <section class="hero">
      <div class="hero-eyebrow">About / Profile</div>
      <div class="hero-stack">
        <div class="profile">
          <div class="avatar-shell">
            <img src="/avatar.png" alt={profile.name} class="avatar">
          </div>
          <div class="profile-copy">
            <h1 class="hero-title">{profile.name}</h1>
            <div class="hero-role">{profile.role}</div>
            <p class="hero-bio">{profile.bio}</p>
          </div>
        </div>

        <aside class="hero-card">
          {/* About 页面面向开源社区展示，不显示简历跳转，只保留社区相关外链。 */}
          <div class="hero-actions">
            {aboutContacts.map((contact, index) => (
              <a
                class={`button ${index === 0 ? 'primary' : ''}`}
                href={contact.href}
                target={contact.external ? '_blank' : undefined}
                rel={contact.external ? 'noopener' : undefined}
                data-copy-email={contact.href.startsWith('mailto:') ? 'true' : undefined}
                data-email={contact.href.startsWith('mailto:') ? contact.href.replace('mailto:', '') : undefined}
              >{contact.label}</a>
            ))}
          </div>
        </aside>
      </div>
    </section>

    <section class="section">
      <div class="section-header">
        <div><h2>开源项目</h2></div>
      </div>
      <div class="project-list">
        {openSourceProjectCards.map((project) => (
          <a href={getProjectHref(project.slug)} class="project-card">
            <div class="project-top">
              <span class="project-name">{project.title}</span>
              <span class="project-arrow">→</span>
            </div>
            <div class="meta-row">
              {project.meta.map((item) => (
                <span class="meta-pill">{item}</span>
              ))}
            </div>
            <p class="project-desc">{project.description}</p>
            <div class="tag-row">
              {project.tags.map((tag) => (
                <span class="tag">{tag}</span>
              ))}
            </div>
          </a>
        ))}
      </div>
    </section>

  </div>
  <script is:inline>
    document.querySelectorAll('[data-copy-email="true"]').forEach((link) => {
      const originalLabel = link.textContent?.trim() ?? 'Email';
      let resetTimer;

      link.addEventListener('click', async (event) => {
        event.preventDefault();

        const email = link.getAttribute('data-email');
        if (!email) {
          return;
        }

        try {
          await navigator.clipboard.writeText(email);
          link.textContent = '已复制邮箱';
          clearTimeout(resetTimer);
          resetTimer = window.setTimeout(() => {
            link.textContent = originalLabel;
          }, 1600);
        } catch {
          window.location.href = `mailto:${email}`;
        }
      });
    });
  </script>
</body>
</html>


